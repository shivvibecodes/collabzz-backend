NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/collabzz?retryWrites=true&w=majority&appName=collabzz

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=collabzz-assets
R2_REGION=auto
R2_PUBLIC_URL=https://cdn.example.com
R2_PRESIGNED_TTL_SECONDS=900

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
